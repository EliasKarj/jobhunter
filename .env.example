# Kopioi tiedostoksi .env ja muokkaa. .env ei kuulu versionhallintaan.

# Pisteytystapa: keyword (nykyinen, oletus) | semantic | hybrid
SCORING_MODE=keyword

# Embedding: local (sentence-transformers, CPU) | openai
EMBED_BACKEND=local
EMBED_MODEL=BAAI/bge-m3
# Vain jos EMBED_BACKEND=openai (esim. EMBED_MODEL=text-embedding-3-small)
OPENAI_API_KEY=

# Pilkkominen (merkkejä)
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Aggregointi: topk_mean | max | mean
AGGREGATION=topk_mean
AGG_K=3

# Hybridi: weighted | rrf. Painot normalisoidaan summaamaan 1:een.
HYBRID_METHOD=weighted
W_KEYWORD=0.6
W_SEMANTIC=0.4
RRF_K=60

# Tallennus ja profiili
RAG_DB=data/rag.sqlite
CV_PATH=data/cv.md
# CV:n osiot, jotka jätetään pois semanttisesta profiilista (otsikon osa, ;-eroteltu).
# Esim. alan ulkopuolinen työkokemus, ettei sen alan ilmoitukset saa korkeaa semanttista pistettä.
CV_SKIP_SECTIONS=
# Karsi indeksistä ilmoitukset, joita ei ole nähty haussa näin moneen päivään
PRUNE_DAYS=14
EMBED_BATCH=16
# Päivitä indeksi automaattisesti webappin haun jälkeen (semantic/hybrid-tilassa)
RAG_AUTO_INGEST=1

# Kielimalli (chat, sopivuusselitys, hakemuspaketti): ollama (paikallinen, oletus) | claude
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b
# Vain jos LLM_PROVIDER=claude. Huom: CV ja ilmoitukset lähetetään tällöin Anthropicille.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Valinnainen parempi malli saatekirjeille (esim. claude-sonnet-5-5); tyhjä = CLAUDE_MODEL
CLAUDE_MODEL_WRITING=

# Kärjen sopivuusarvio: off | ollama | claude. Lähettää vain ilmoitukset ja nimettömän tiivistelmän.
SCORE_PROVIDER=off
SCORE_TOP=500
SCORE_WORKERS=6

# CV-arviointipaneeli (4 arvioijaa). Tyhjä malli = CLAUDE_MODEL. Hinnat $/miljoona tokenia mallin hinnastosta;
# 0 = näytetään vain tokenit.
PANEL_MODEL=
PANEL_PRICE_IN=0
PANEL_PRICE_OUT=0

# Etäkäyttö Tailscalen kautta (tailscale serve). Tailscale-käyttäjät (esim. nimi@github) ja koneen
# tailnet-osoite. Tyhjä = etäkäyttö estetty. Asetukset ja avaimet ovat etänä aina lukossa.
REMOTE_USERS=
REMOTE_HOSTS=

# Datakansio: kaikki oma data (CV, profiili, hakemukset, arkisto, välimuisti). Oletus: data/ repon juuressa.
# Voi olla repon ulkopuolella, esim. JOBHUNTER_DATA=C:\Users\nimi\jobhunter-data
# JOBHUNTER_DATA=
